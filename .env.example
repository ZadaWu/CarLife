# CarLife 环境变量样例（施工单 M2-02 / 2026-08 语音链切换）。
# 复制为仓库根 .env 后填入真实值；服务与 cockpit 均会自动加载（已存在的环境变量优先）。
# 真实密钥不入库（.gitignore 已覆盖 .env / .env.*）。

# ── 数据库（infra/docker-compose.yml，宿主端口 55433 避开本机已占用端口）
DATABASE_URL="postgresql://carlife:carlife@localhost:55433/carlife"
# 测试专用库（M45-01）。**与开发库物理分开**：同一个 PG 容器、另一个库。
# 跑测试前先建一次：`corepack pnpm db:test:setup`（幂等，可反复跑）。
#
# 为什么要分：e2e 的准备阶段会 deleteMany 掉 demo-user 的车辆与行程，
# 而 `demo:seed` 播的正是同一个 userId——共用一个库时，跑一次端到端演示数据就没了。
#
# ⚠️ 库名必须以 `_test` 结尾，否则测试**拒绝运行**（不是警告，是退出）。
# 这道闸挡的是"哪天有人图省事把它指回开发库"——那种改动不会报错，
# 只会在某次演示前表现成"数据怎么没了"。不配则用下面这个默认值。
TEST_DATABASE_URL="postgresql://carlife:carlife@localhost:55433/carlife_test"

# ── LLM（§5.1：Vercel AI SDK + DeepSeek；缺省时 runtime 用确定性 Fake 模型）
DEEPSEEK_API_KEY=""
# CARLIFE_LLM=fake            # 强制离线 Fake（开发/测试）

# ── ASR：豆包 omni（火山方舟 Ark；缺省时用 Fake）
ARK_API_KEY=""
# ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
# ARK_ASR_MODEL="doubao-seed-2-0-mini-260428"
# ASR_ENGINE=fake             # 测试专用：固定文本、不看音频（仅 env 注入，不进后台下拉）
# CARLIFE_ASR_FAKE_TEXT="…"   # fake 档固定返回文本
#
# 本地 ASR 档（ACR-006 定容器形态，ACR-007 换 llama.cpp + Qwen3-ASR-0.6B GGUF）：
# 不依赖第三方账号余额，也不依赖 Host 二进制。模型是两个 GGUF 文件（主模型 + mmproj），
# 先准备模型并启用 Compose profile：
#   corepack pnpm dev:asr:setup
#   corepack pnpm dev:start local-asr
# 或直接运行 dev:bootstrap；它会在 local 模式下先校验模型，再启动并等待容器。
# 默认模型目录与 setup 工具一致（目录名沿用 whisper-models，避免重新缓存）；
# 需要改目录时两边都读取这个变量。
# WHISPER_MODEL_DIR="/absolute/path/to/whisper-models"  # 不填则使用用户缓存目录
# 然后放开下面这行（ACR-017 起 mock = 本机容器档，原名 local）。
# ⚠️ .env 写了 ASR_ENGINE 即**钉死档位**：后台该项变只读（source 显示 env），
# 要热切就别在这里写。钉死的用途是"账号欠费/配置层故障时部署层兜底"。
# ASR_ENGINE=mock            # mock=local-asr 容器（真模型跑本机）；与 TTS_ENGINE=mock 不是同一个服务
# 宿主 Gateway 访问 Compose 发布端口（llama-server 的 OpenAI 风格转写端点）：
# LOCAL_ASR_URL="http://127.0.0.1:8795/v1/audio/transcriptions"
# 本地档强制语种，默认 Chinese（Qwen3-ASR 自动判语种在噪声段会吐任意语言，实测出过
# 葡萄牙语）；强制中文时网关同时启用 CJK 守门——整段无中文字符的输出按非语音丢弃。
# 置空回到自动判定并关闭守门：
# LOCAL_ASR_LANGUAGE=""
#
# ── 阿里云百炼档（ACR-015；ASR 与 TTS 共用一把 key）
# ASR 的 vendor 由后台「系统配置 → ASR」的 ASR_ENGINE 热切（ark｜aliyun｜mock）；
# .env 里写 ASR_ENGINE 即钉死（ACR-017，见上）。
DASHSCOPE_API_KEY=""
# DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/api/v1"
# ALIYUN_ASR_MODEL="qwen3-asr-flash"          # 同步档；-filetrans 异步档要公网 URL，别换
# ALIYUN_TTS_MODEL="qwen3-tts-flash"
# ALIYUN_TTS_VOICE="Cherry"
#
# ── 日用量闸门（ACR-016；真相源在 DB，后台可热改，这里只是初值）
# 云厂商只有预算告警没有"花到 X 自动停"，硬闸得自己设。0 = 不限（默认）。
# 超限不是拒绝而是降级：ASR 落本地档（免费）、TTS 端上落系统 say。
# **它不是账单上限**——只挡我们这一侧的调用量，供应商那边仍要看余额。
# ASR_DAILY_CALL_LIMIT=0            # 云 ASR 每日调用次数；大头是哨兵唤醒词转写
# TTS_DAILY_CHAR_LIMIT=80000        # 云 TTS 每日合成字符；ACR-018 起三档全过网关，
#                                   # 这个闸对 doubao 也生效。默认 80000（约 52 元/天），
#                                   # 写 0 = 不限

# ── TTS：豆包 seed-tts-2.0（字节 openspeech）——**服务端配置，端上不读**
# ACR-018 起合成全部经网关 /v1/tts/speech，密钥只在服务端被使用；车机/手机
# 手里没有任何 vendor 密钥（真机上本来也没有 .env，那条路一直是坏的）。
# 密钥**只在后台把 TTS_ENGINE 切到 doubao 时才被用到**；默认档是 mock，
# 这里留空完全没问题（mock 档网关自动补占位值，整条 HTTP 链照常跑）。
# 切到豆包而这里没配时，网关拒绝合成并回错误行，端上据此降级系统 TTS——
# 不会拿占位值去打计费接口。
BYTEDANCE_TTS_API_KEY=""
# BYTEDANCE_TTS_RESOURCE_ID="seed-tts-2.0"
# BYTEDANCE_TTS_SPEAKER="zh_female_vv_uranus_bigtts"   # 音色见火山文档 6561/1871062
# CARLIFE_TTS 已随 ACR-017 退休：要立刻闭嘴用车机设置页的「播报开关」（热生效）；
# 选引擎用后台 TTS_ENGINE；网关问不到时端上自动降级系统 say（免费），不再回落
# 本地环境变量里的端点。say 的音色仍可配：
# CARLIFE_TTS_SAY_VOICE="Tingting"
#
# ── 端侧语音的本地开关（车机/手机自己的表现，**服务端一项都不读**）
# 这三项走 clients/*/src-tauri/src/dev_env.rs 的客户端白名单，只在 `tauri dev`
# 时从仓库根 .env 载入；打包分发的客户端不读 .env（真机上本来也没有这个文件）。
#
# ⚠️ **放开时不要在值后面接行内注释**：那个加载器只做 trim + 去引号，不认 `#`，
#    `CARLIFE_AEC_ENABLED=1  # 开` 会被读成值 `1  # 开`，判等 "1" 失败——
#    表现是"我明明开了 AEC，日志里那行启用提示却不出现"，全程零报错。
#
# 声学回声消除总开关（ACR-010 / M47-02）。**默认关**：开了才把采集帧过 AEC。
# 调参期它是工程开关不是用户偏好，所以只读环境变量、不做端上偏好页，重启生效。
# CARLIFE_AEC_ENABLED=1
#
# 覆盖平台默认 stream delay，免得每扫一档就重编译（M47-03 / M47-05 的调参就靠它）。
# auto = 按平台默认；非法值只打一行告警并回落默认，不会启动失败。
# iOS 传不进环境变量，那边只能改 aec_bridge.rs 的常量重装。
# CARLIFE_AEC_DELAY_MS=auto
#
# 哨兵排障：打逐条转写与判定（含 dur / truncated），以及每 5s 一行 AEC 状态
# （fed / dropped / 播放中 / 帧长）。
# ⚠️ **只在开发机开，车上永远不开**——它会把未命中唤醒词的转写正文打进日志，
#    而 AC-52-5 要求那些内容判定后即弃、不留任何副本。
# CARLIFE_SENTINEL_DEBUG=1
#
# ── TTS 引擎开关（后台「系统配置 → TTS」可热切，**改这里只是给个初值**）
# 真相源是 DB：后台改完约 30s 内端上自动改口，不必重启客户端，也不必改本文件。
# 默认 mock 是刻意的——开发期的默认值不该是计费的那个（INC-0030）。
# ⚠️ .env 写了 TTS_ENGINE 即钉死档位（ACR-017，同 ASR_ENGINE），要热切就别写：
# TTS_ENGINE=mock                   # mock=mocks/tts（本机 say 包装成豆包协议，8794，不计费）
#                                   #   ——与 ASR_ENGINE=mock 不是同一个服务：那个跑的是真模型
#                                   # ｜doubao=豆包（按字计费）
#                                   # ｜aliyun=百炼 qwen3-tts-flash（按字符计费，走网关门面，密钥不下端）
# MOCK_TTS_URL="http://localhost:8794/api/v3/tts/unidirectional"
#
# ── mock-tts：本机 `say` 假扮 seed-tts-2.0（mocks/tts，**仅 macOS**；
# 其它平台 dev.sh 默认不起它，TTS 走豆包或百炼）
# 与端上那条 say 降级路径的区别是**它走完整条网络链**：请求体形状 / NDJSON 分帧 /
# base64 拼接 / mp3 解码 / afplay 播放。端上降级 say 在发 HTTP 之前就短路了，
# 那条链在开发期一次都没跑过——而 INC-0030 的 18 路重叠播报恰恰出在这条链上。
# ⚠️ 它与 ASR_ENGINE=mock 的 local-asr 容器**是两个不同的服务**，别因为同名混淆。
# 用法：起 mock-tts，引擎在后台选（默认就是 mock）。**不需要任何密钥**——
# mock 只校验请求头带没带 Key、不校验值，端上会自动补占位值。
MOCK_TTS_PORT=8794
#
# ⚠️ ACR-017 起**车机不再用它做兜底**：网关问不到合成端点时直接降级系统 say
# （免费），不再回落 TtsClient 的默认端点——那个默认是豆包，旧行为等于
# "网关抖了一下就把这台开发机接上计费引擎"，且一声不响。
# ⚠️ ACR-018 起**端上连读都不读它了**（`from_env()` 已删，端上没有任何
# 自己拼端点的能力）。本行现在只服务于服务端：mock 档的上游地址由
# MOCK_TTS_URL / 本行提供，网关自己去打。
BYTEDANCE_TTS_URL="http://localhost:8794/api/v3/tts/unidirectional"
# MOCK_TTS_SAY_VOICE="Tingting"     # 覆盖音色映射；不设则按 speaker 里的性别词猜

# ── 服务端口（与 infra/scripts/dev.sh 的就绪检查、Compose 对外端口同一口径：
# gateway 8790 / runtime 8791。dev.sh 按这两个端口探活，改动要三处同步。）
GATEWAY_PORT=8790
AGENT_RUNTIME_PORT=8791
AGENT_RUNTIME_URL="http://localhost:8791"
# runtime 的监听地址。默认 0.0.0.0，**容器部署必须保持默认**——gateway 经 docker
# 网络按服务名访问它（AGENT_RUNTIME_URL=http://agent-runtime:8791），绑回环会让
# 那条链当场断掉。容器里的暴露面由 compose 的 `expose`（而非 `ports`）兜着。
# 开发机在公共网络时打开下面这行收紧：/internal/* 没有鉴权，0.0.0.0 意味着
# 同一段 Wi-Fi 上的任何人都能打它。
# AGENT_RUNTIME_BIND=127.0.0.1
CARLIFE_GATEWAY_URL="http://localhost:8790"

# ── Agent 运行时开关（都有代码内默认值，列在这里是让模板与读取点一一对应）
# CARLIFE_AGENT_RUNTIME=acp     # acp=经 pi/ACP（默认）｜direct=直连 LLM 不走 pi
# CARLIFE_ANSWER_RUNTIME=acp    # 表述路径（与上面是两回事）：direct=answer 节点直连 narrator
# CARLIFE_ANSWER_MODEL=""       # direct 表述模型，默认 deepseek-v4-flash
# CARLIFE_TITLE_MODEL=""        # 会话标题生成模型，默认 deepseek-v4-flash
# CARLIFE_SIDE_TASKS=on        # 复合意图的副任务（ACR-023）：off=意图提示词不带 sideTasks、图只起主 lane；权限门排队不受它影响
# CARLIFE_PROBE_RATE_LIMIT=6    # 后台连通性探针限流（次/60s）

# 会话空闲多久算结束（M22-01）。默认 30 分钟；空闲超过它之后再发消息会拿到
# 409 session_expired，端上据此开新会话。**软关闭，历史一条不删。**
# 配成 0 或负数会回落默认值——配成 0 等于每条消息都判过期，整个对话功能停摆。
CARLIFE_SESSION_IDLE_MIN=30
# 模拟经销商系统（M19-01）。它是**开发期的假第三方**，不是基础设施依赖——
# 关掉它是 Demo 的一部分（上游要如实说"门店系统没连通"，而不是继续报门店名）。
MOCK_DEALER_PORT=8792
MOCK_DEALER_URL="http://localhost:8792"

# 模拟车机舒适域（座舱）。与 mock-dealer 同一哲学：假第三方、可当场 kill 演示降级。
# 只有设置值（空调 23 度、座椅加热 2 档），不认识人——偏好归 Agent 侧管理。
MOCK_CABIN_PORT=8793
MOCK_CABIN_URL="http://localhost:8793"

# 模拟 4S 维修系统（M41-01）。同一哲学：假第三方、关掉它是 Demo 的一部分
# （上游要如实说"维修系统没连通"）。历史维修记录/预约维修/维修中报价单三域，
# 种子与 demo:seed 的两辆演示车按 VIN 对齐。8796 被 worker 探活占用，故 8797。
MOCK_REPAIR_PORT=8797
MOCK_REPAIR_URL="http://localhost:8797"

# 模拟保险系统（M41-02）。保单查询 + 按维修报价单理赔预检（确定性测算、
# 响应自带免责与规则自述）。与 mock-repair 互不调用，组合在工具层。
MOCK_INSURANCE_PORT=8798
MOCK_INSURANCE_URL="http://localhost:8798"

# ── worker 定时任务的探活端点（F-32-12）
# 只读，不接受任何触发动作——手动跑任务走 `--once`，那是有副作用的命令行操作。
# 它回答的是"worker 进程此刻在不在"；"任务最近跑过没有"仍由 job_runs 留痕回答。
# 缺了这两个值也不影响任务执行，只影响 /system 那张卡：端口探不到就退回留痕，
# 而留痕的粒度是小时级 cron，于是刚起来的 worker 会被显示成「未启用」。
WORKER_HEALTH_PORT=8796
WORKER_HEALTH_URL="http://localhost:8796"

# ── 旁路闲聊 Agent（M18，US-45）：等待期的语音填充。**默认关**
# 它不降低真实时延，只改变等待期的信息状态。全部为策略值（C 类），可热调。
# SIDECAR_ENABLED=1           # 总开关；不置位即整条旁路不建对象、零开销
# SIDECAR_SILENCE_MS=1500     # 静默多久算该说句话。⚠️ 1500 是**单样本初值**，
#                             #   架构 §13-14 要求用 probe:latency 的 P50~P90 定值，
#                             #   M18-05 复核前不要当结论
# SIDECAR_MIN_GAP_MS=500      # 两句之间的最小间隔。**从上一句估算念完起算**，
#                             #   不是从发出起算（M18-09 修的一个真 bug：
#                             #   第 1 句要念 8 秒，按发出算会在第 4 秒把自己截断）。
#                             #   所以调小它不会让句子互相打断——播报时长永远顶在前面。
#                             #   重试退避**不跟这个值走**，有 2 秒地板（见 budget.ts）
# SIDECAR_SPEECH_MS_PER_CHAR=200  # 播报时长估算。服务端拿不到端上的播完回执，
#                             #   也不该为此加一条上行通道。中文 TTS 约 4~5 字/秒
# SIDECAR_TICK_MS=700         # 重新判定的节拍。span 是**完成时**才落的，
#                             #   检索那 3.8 秒里轨迹侧一个事件都没有，纯事件驱动会哑
# SIDECAR_FILLER_MODEL=deepseek-v4-flash  # L1 导游用的模型。**钉死非推理模型**——
#                             #   跟着 DEEPSEEK_MODEL 走的话，填等待的那句话
#                             #   自己也要想十几秒，而它存在的全部理由就是快
# SIDECAR_FILLER_TEMPERATURE=1.0  # 导游的采样温度。**不传温度时输出是确定性的**——
#                             #   同一个地名连问四次返回一字不差的同一句，
#                             #   prompt 里写"换个角度"也压不住。1.3 起会开始
#                             #   编街道名与地方特产，所以取 1.0（实测 3 档 × 30 句）
#
# ⚠️ 单轮条数上限（SIDECAR_MAX_PER_TURN）与总时长上限（SIDECAR_MAX_TOTAL_MS）
#    在 M18-09 移除了：turn 什么时候结束是**会话超时**的职责，旁路的生命周期
#    本来就绑在 turn 上。旧的 20 秒总上限比 fan-out 的 60 秒汇聚超时还短，
#    表现是长等待每次都在第 20 秒被自己的天花板掐掉。

# ── 端上鉴权（施工单 M48-02 / M49-01，FL-07 F-07-01/02）
# JWT 签名密钥：至少 16 字符。
#   · 开发（NODE_ENV != production）：留空即用内置默认密钥 DEV_JWT_SECRET
#     （定义在 enterprise/backend/shared/db/src/config/registry.ts，仓库里唯一一份字面量），
#     每次启动打一行告警。这是为了让新克隆的仓库直接起得来，不是让你别配。
#   · 生产（NODE_ENV=production）：**不提供默认值，缺失即启动失败**。
#     一个写在公开仓库里的签名密钥等于没有鉴权，而它不会以任何现象暴露
#     （token 照常签发、照常通过）。
# 这里保持留空：本机 .env 照抄时不会把开发默认值固化成一份改不动的副本。
# 生成：openssl rand -hex 32
CARLIFE_JWT_SECRET=""
# 开发账号口令（仅本机）：迁移种下的 demo-user 是**锁定**账号（散列 `!`），
# 用 `corepack pnpm --filter @carlife/gateway seed:dev-credentials` 给它设口令。
# 缺省 carlife-dev。生产账号走 POST /console/users（admin token），不用这个。
CARLIFE_DEV_PASSWORD=""

# ── 后台（施工单 M3-01 / M3-02）
# 角色 token：与端上 JWT 是两条互不影响的鉴权路径。
# POC 简化形态，退出条件见 enterprise/backend/gateway/src/auth/console.ts（FL-07 F-07-01）。
CARLIFE_ADMIN_TOKEN="admin-token"
CARLIFE_OPS_TOKEN="ops-token"
# 配置加密主密钥（§13-12）：至少 16 字符，**不与密文同库**，缺失即启动失败。
# 生成：openssl rand -hex 32
CARLIFE_CONFIG_MASTER_KEY=""
# PII 落盘加密主密钥（M42-01）：车辆成员的联系人字段（称呼/关系/备注/手机号）
# AES-256-GCM 加密落库、读取透明解密。与配置主密钥**独立两把钥匙**（轮换周期
# 与泄露影响面不同），同样至少 16 字符、不与密文同库、缺失即启动失败。
# 存量数据迁移：corepack pnpm --filter @carlife/db db:pii:encrypt（幂等可重跑）
# 生成：openssl rand -hex 32
CARLIFE_PII_MASTER_KEY=""

# ── 日历真实写入（M43-02，FL-31 最小段）
# mock（默认，假回执）| google | caldav | both（一次确认双日历都出现）。
# **显式选真后端但凭证不齐 → 启动报错**，不静默回 mock（用户确认过的写入不能落到假后端）。
# CARLIFE_CALENDAR_BACKEND=mock
# Google：Cloud 项目 OAuth 客户端 + 一次授权换 refresh token——
#   corepack pnpm --silent tsx scripts/dev/demo/google-calendar-auth.ts（步骤见 内部文档）
# GOOGLE_CAL_CLIENT_ID=""
# GOOGLE_CAL_CLIENT_SECRET=""
# GOOGLE_CAL_REFRESH_TOKEN=""
# GOOGLE_CAL_CALENDAR_ID=""
# Apple（iCloud CalDAV）：Apple ID + App 专用密码（appleid.apple.com 生成，不是登录密码）。
# APPLE_CALDAV_URL 可选：发现失败时直填日历集合地址兜底。
# APPLE_CALDAV_APPLE_ID=""
# APPLE_CALDAV_APP_PASSWORD=""
# APPLE_CALDAV_URL=""
# 配置缓存 TTL（毫秒，默认 30000）。改配置后最长等这么久生效；e2e 用短值。
# CARLIFE_CONFIG_TTL_MS=30000
# Fake 模型回复前缀（仅离线开发可见，用于验证配置热生效路径）
# CARLIFE_LLM_FAKE_TAG=""
# DeepSeek 模型与端点（可在后台热改，此处为兜底默认）
# DEEPSEEK_MODEL="deepseek-v4-flash"
# DEEPSEEK_BASE_URL=""
# 目的地推荐的联网搜索（M32-01）：走 DeepSeek 的 **Anthropic 兼容端点**声明服务端工具
# web_search，与上面那条 OpenAI 兼容路径是两条腿，所以模型名也分开配——
# 共用一个来源的话，有人把对话模型调成别的，搜索也跟着连坐。
# 密钥复用 DEEPSEEK_API_KEY；不配这两项就吃下面的默认值。
# DEEPSEEK_ANTHROPIC_BASE_URL="https://api.deepseek.com/anthropic"
# DEEPSEEK_SEARCH_MODEL="deepseek-v4-flash"
# 导览采集任务队列（ACR-008，pg-boss）：on 时行程确认后自动逐景点后台采集。
# ⚠️ 费用面：每个景点最多 3 次按次计费联网搜索（24h 缓存 + 单飞封顶）。
# 缺省关——关着时零行为变化（不加载 pg-boss、不建 pgboss schema、不入队）。
# GUIDE_QUEUE="on"
# LLM 成本估算单价（元/1K token，可在后台热改）
# LLM_PRICE_PROMPT_PER_1K="0.003"
# LLM_PRICE_COMPLETION_PER_1K="0.009"
# TTS_PRICE_PER_10K_CHARS="6.5"
# ASR_PRICE_INPUT_PER_1K="0.003"
# ASR_PRICE_OUTPUT_PER_1K="0.002"
# 对话历史保留天数；0 = 长期保留（M3-07 承接 M2-06 F-03-11）
# HISTORY_RETENTION_DAYS=0

# 工具层 Mock 三态（real / mock / off）——见 enterprise/backend/shared/tools/src/external.ts
CARLIFE_TOOLS=real

# 内容审核（§8.2）。TD-04 起默认走阿里云 AI 安全护栏；
# openai-compat 那套保留是为了能换回自建/本地模型——审核层是安全边界，
# 不该被单一供应商的可用性绑死。
GUARD_PROVIDER=aliyun

# 阿里云 AI 安全护栏（green-cip）。AccessKey 需 RAM 授权 AliyunYundunGreenWebFullAccess。
# ⚠️ 某个防护维度是否参与检测由**阿里云控制台**决定，不由我们的策略开关决定：
#    后台把 sensitiveData 打开、而控制台没开，就是"配置看着好好的实际什么也没发生"。
#    用 `corepack pnpm probe:aliyun-guard` 看本账号实际生效哪几个维度。
ALIYUN_GUARD_ENDPOINT=https://green-cip.cn-shanghai.aliyuncs.com
Aliyun_AccessKey_ID=
Aliyun_AccessKey_Secret=
# 实测：sensitiveData（敏感内容检测）只在 _pro 版返回；关掉 pro 等于控制台那个维度白开
ALIYUN_GUARD_PRO=true
ALIYUN_GUARD_TIMEOUT_MS=5000

# 自建 / 本地审核模型（GUARD_PROVIDER=openai-compat 时生效）。
# GUARD_BASE_URL 留空 = 审核层未接入（规则筛与脱敏仍生效，且结果标注未审核）
GUARD_MODEL=qwen3guard-gen
GUARD_BASE_URL=
GUARD_API_KEY=
GUARD_TIMEOUT_MS=10000

# 裁决审计落库（M37-04，guard_audit_logs 表；追加式，含放行）。
# GUARD_AUDIT_PERSIST=0 时退回内存（重启即丢）——仅离线/演示用，生产别关。
GUARD_AUDIT_PERSIST=1
# allow 放行记录的采样率（0~1，默认 1 全量）。deny/needs_confirmation 永远全量落，
# 被采样掉的 allow 仍进内存 sink（误伤样本审查的数据源不能采丢）。
GUARD_AUDIT_SAMPLE_ALLOW=1

# Mem0 记忆存储（§7 ②③⑥ / M7-01）
#
# 没有 MEM0_URL：mem0ai 的 TS OSS 形态是**进程内库**，不是服务。
# 要配的只有两个后端——向量库落哪、embedding 用谁。
#
# pgvector = 复用现有 PG（§13-11 方案 A），备份归入同一条 pg_dump。
# 改成 memory 会落到本地 sqlite 文件，**那份数据在备份面之外**，仅供离线实验。
MEM0_VECTOR_PROVIDER=pgvector
MEM0_COLLECTION=carlife_memories
# 留空则回落到 DATABASE_URL（同一台 PG）
MEM0_DATABASE_URL=
# embedding 走本地 Ollama：不出网、无 API key。DeepSeek 没有 embedding 接口，
# 所以这条不能复用 LLM 端点。换模型必须同步改 DIMS（nomic-embed-text=768，bge-m3=1024）。
MEM0_EMBEDDING_BASE_URL=http://localhost:11434
MEM0_EMBEDDING_MODEL=nomic-embed-text
MEM0_EMBEDDING_DIMS=768

# RAGFlow Cloud（§6 / M8-01）。本仓不自建向量库，检索全托管。
# 留空 = 未接入：双路检索只剩⑥那一路，回答会显式标注"本次未引用说明书出处"。
RAGFLOW_BASE_URL=
RAGFLOW_API_KEY=
# 三个数据集 id 分开配——隔离靠 id 在调用层强制，不靠 prompt
RAGFLOW_DATASET_VEHICLE_MANUALS=
RAGFLOW_DATASET_REPAIR_KB=
RAGFLOW_DATASET_CAR_CATALOG=

# 高德开放平台（§5 工具表「地图 API」/ M10-01）。https://console.amap.com
# 两把 key 属于两种应用类型，**不能互换**：Web 服务 key 在浏览器里调会被拒，
# Web 端(JS API) key 在服务端调同样不行。填错的表现是 infocode=10009/10001。
#
# 服务端：weather 沿途天气 + map_route 路径规划。留空 = 天气退回 Open-Meteo
# （没有中文天气现象）、map_route 明确返回未接入。
AMAP_SERVER_KEY=
# ── 财务页（后台 /finance，admin 独有）：外部账户余额与订阅状态
#
# 火山引擎费用 OpenAPI（QueryBalanceAcct）只认**账号级 AK/SK 签名**，
# 上面那把 ARK_API_KEY 是方舟的模型调用凭据，查不了余额，两者不能互相顶替。
# 取 AK/SK：https://console.volcengine.com/iam/keymanage/
VOLC_ACCESSKEY=
VOLC_SECRETKEY=
# 阿里云余额复用内容审核那对凭据（Aliyun_AccessKey_ID / Aliyun_AccessKey_Secret，见下）。
# DeepSeek / RAGFlow / 高德复用各自已有的 key，无需再配。
#
# 余额预警阈值与缓存。高德那条探针本身要消耗当日免费额度，
# 所以默认吃 60s 缓存——别把这一页做成烧额度的来源。
# CARLIFE_FINANCE_WARN_CNY=50
# CARLIFE_FINANCE_DANGER_CNY=10
# CARLIFE_FINANCE_TTL_MS=60000
# CARLIFE_FINANCE_TIMEOUT_MS=12000
# 账单缓存单独一条且长得多：账单是已结算的历史，不会一分钟一变，
# 而拉一次要按账期打 3 次上游——跟余额同一个 60s 口径，人在卡片间来回点就会把上游打满。
# CARLIFE_FINANCE_BILLS_TTL_MS=600000
# 快照落盘位置（缓存不是账本，丢了无损失）。重启后页面先秒开上次的样子再后台刷新。
# CARLIFE_FINANCE_STATE_FILE=var/finance-cache.json   # 相对网关进程 cwd（pnpm 启动时为 enterprise/backend/gateway/）
# 余额的采样历史（卡片下方那条 7 天曲线）。与上面的缓存分两个文件：缓存丢了下次采集就有，
# 历史丢一个周期就永远少一个周期。网关内的定时器每个周期采集一轮来喂它。
# 周期是唯一的旋钮：桶宽、接口下发的 stepMs、页面上"每 N 分钟采样一次"那句话都由它推。
# 代价按周期算：10 分钟 = 每天 144 轮上游调用（含高德那条消耗当日额度的探针）；
# 调成 60 就回到每天 24 轮。取值夹在 [1, 1440] 分钟，填 0/负数/非数字一律退回默认 10。
# CARLIFE_FINANCE_HISTORY_INTERVAL_MIN=10
# CARLIFE_FINANCE_HISTORY=off                             # 定时器与记点一起停
# CARLIFE_FINANCE_HISTORY_FILE=var/finance-history.json   # 同样相对网关进程 cwd

# 客户端：车机 HUD 的真实地图底图。留空 = 回退程序化 SVG 底图（离线也是这条路径）。
# 它**随前端产物下发，而且没有办法不下发**——加载 SDK 的 script 标签必须带它。
# 安全性靠高德控制台的域名白名单，不靠保密。
AMAP_JS_KEY=
# JS API 安全密钥——**服务端配置，端上不读**（ACR-019）。
# 网关的 /_AMapService/* 代理在转发时追加它（enterprise/backend/gateway/src/http/amap-proxy.ts），
# 前端只知道代理地址。ACR-019 之前它直填进前端产物，那条路已经删了。
AMAP_JS_SECURITY_CODE=
# 中国气象局天气增强（M10-02）。无 key，大陆可达，默认开。
# 它补的是高德给不了的：体感温度、湿度、降水实况、气压、风、气象预警，
# 并把预报窗口从高德的 4 天拉到 7 天。**紫外线指数与能见度它也没有**。
# 置 off 可一键关掉（接口是公开网页的内部接口，改版失效时用它止血）。
# CARLIFE_WEATHER_CMA=on
# 注意：vite 只把 VITE_ 前缀的变量注入前端产物，所以两个端要在 .env 里另给一份
# 同值的 **VITE_AMAP_JS_KEY**（构建期注入，不是运行时配置项，故不进配置注册表）。
# ⚠️ **VITE_AMAP_JS_SECURITY_CODE 已随 ACR-019 退休**：安全密钥不再进产物，
# 端上只知道网关代理地址。.env 里若还留着这一行，它不再被任何代码读取——删掉即可。

# 对象存储（§9 / M8-04）。附件桶与知识库分开——用户上传的内容不进知识库。
# 留空 = 上传未接入（接口明确返回未接入，不假装成功）。
S3_ENDPOINT=http://localhost:59000
S3_ACCESS_KEY_ID=carlife
S3_SECRET_ACCESS_KEY=carlife-secret
S3_BUCKET=carlife-attachments

# MinerU（PDF 版面解析，M8-01）。**多栏 PDF 必须经它转换**——
# RAGFlow 的 DeepDOC 会把三栏按行横着串读，而那个错误带着出处、看起来完全正常。
# 留空则只能传单栏 PDF。
MINERU_API_TOKEN=

# ── ⑤环境缓存（§7⑤，M11-04）。Redis 见 infra/docker-compose.yml（宿主端口 56379）。
# 未配置即不缓存——天气与路线全部直连上游，功能不受影响，只是慢且费配额。
REDIS_URL=redis://localhost:56379

# ── iOS 构建签名（仅本机需要，不入库）。tauri.conf.json 不写死 developmentTeam，
# Apple Team ID 走环境变量注入（tauri ios init / build 均读取）：
# TAURI_APPLE_DEVELOPMENT_TEAM=""

