# 反代到网关的公共设置。两个 location（一般 /v1/ 与单独限流的发消息）都 include 它，
# 避免两份配置各自漂移——SSE 那三行少一行，表现就是"流式变成憋一坨再吐"，
# 而它只在其中一条路径上出问题，最难对上号。
proxy_pass ${DEMO_UPSTREAM};
proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

# 合成标准的 Authorization 发给网关——**网关一行没改**，它收到的仍是标准形态。
# 页面不能直接发 Authorization：平台把它连同 X-modelscope-* / X-studio-*
# 保留给自己了（官方文档明写），带着它的请求根本到不了这个容器，边缘直接回 403。
# $carlife_auth 由 http{} 里的 map 合成：有头用头、没头用 cookie、都没有就是空串
# ——nginx 对空值的头直接不发，登录这类请求因此不受影响。
proxy_set_header Authorization $carlife_auth;

# SSE 的三件套，少一件都会让"流式"变成"憋一坨再吐"：
#   proxy_buffering off          不攒够一个 buffer 才下发
#   chunked_transfer_encoding on 不等 Content-Length
#   read_timeout 拉长            一句话办三件事那种要两分钟不出字，默认 60s 会把流掐了
proxy_buffering off;
proxy_cache off;
chunked_transfer_encoding on;
proxy_set_header Connection "";
proxy_read_timeout 300s;
proxy_send_timeout 300s;
